# DomeCypress – .gitignore
# Repo layout: Blender files + Python build scripts at the root,
# Unity project inside /domecypress.
# Patterns are NOT anchored to the root so they also match inside domecypress/.

# ---------------- Unity generated folders ----------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
ProfilerCaptures/
.utmp/

# Player build output (domecypress.exe etc.)
domecypress/output/
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Unity scene auto-recovery
domecypress/Assets/_Recovery/
domecypress/Assets/_Recovery.meta

# Autogenerated JetBrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Packed Addressables / temp Android assets
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------- IDE / solution files ----------------
.vs/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------- Builds / crash files ----------------
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
sysinfo.txt
crashlytics-build.properties
*.log

# ---------------- Blender ----------------
# Blender auto-backups (.blend1, .blend2 ...)
*.blend[0-9]
*.blend[0-9][0-9]
__pycache__/
*.pyc

# One-off backup export
*_backup_*.fbx

# ---------------- OS junk ----------------
Thumbs.db
Desktop.ini
.DS_Store
